{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "home lab DNS benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "timestamp", "repetitions", "queries", "aggregate_warm_median_ms", "caveats"],
  "properties": {
    "schema_version": {"const": "1"},
    "benchmark": {"const": "dns"},
    "timestamp": {"type": "string", "format": "date-time"},
    "repetitions": {"type": "integer", "minimum": 2},
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain_class", "phase", "success", "wall_time_ms", "response_class", "answer_count"],
        "properties": {
          "domain_class": {"enum": ["allowed", "block-test"]},
          "phase": {"enum": ["cold", "warm"]},
          "success": {"type": "boolean"},
          "wall_time_ms": {"type": "number", "minimum": 0},
          "response_class": {"enum": ["resolved", "blocked", "nxdomain", "no-a-answer"]},
          "answer_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "aggregate_warm_median_ms": {"type": "number", "minimum": 0},
    "caveats": {"type": "array", "items": {"type": "string"}}
  }
}
