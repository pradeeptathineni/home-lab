{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/home-lab/ai-engine.schema.json",
  "title": "home lab llama.cpp engine benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "timestamp", "host", "runtime", "model", "configuration", "samples", "aggregate", "power", "wall_time_seconds", "runtime_metadata", "raw", "caveats"],
  "properties": {
    "schema_version": {"const": "1"},
    "benchmark": {"const": "ai-engine"},
    "timestamp": {"type": "string", "format": "date-time"},
    "host": {"$ref": "#/$defs/host"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "model": {"$ref": "#/$defs/model"},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threads", "context_tokens", "prompt_tokens", "generation_tokens", "repetitions"],
      "properties": {
        "threads": {"type": "integer", "minimum": 1},
        "context_tokens": {"type": "integer", "minimum": 1},
        "prompt_tokens": {"type": "integer", "minimum": 1},
        "generation_tokens": {"type": "integer", "minimum": 1},
        "repetitions": {"type": "integer", "minimum": 5}
      }
    },
    "samples": {"$ref": "#/$defs/engineMetrics"},
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens_per_second", "generation_tokens_per_second"],
      "properties": {
        "prompt_tokens_per_second": {"$ref": "#/$defs/aggregate"},
        "generation_tokens_per_second": {"$ref": "#/$defs/aggregate"}
      }
    },
    "power": {"$ref": "#/$defs/power"},
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "runtime_metadata": {"type": "object"},
    "raw": {},
    "caveats": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "host": {"type": "object", "required": ["class", "os", "os_version", "architecture"]},
    "runtime": {"type": "object", "required": ["name", "version", "backend"]},
    "model": {"type": "object", "required": ["id", "family", "source", "revision", "digest", "quantization", "bytes"]},
    "power": {"type": "object", "required": ["source", "battery_percent"]},
    "engineMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens_per_second", "generation_tokens_per_second"],
      "properties": {
        "prompt_tokens_per_second": {"type": "array", "minItems": 5, "items": {"type": "number", "minimum": 0}},
        "generation_tokens_per_second": {"type": "array", "minItems": 5, "items": {"type": "number", "minimum": 0}}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "min", "median", "max"],
      "properties": {
        "raw": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "min": {"type": "number", "minimum": 0},
        "median": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      }
    }
  }
}
