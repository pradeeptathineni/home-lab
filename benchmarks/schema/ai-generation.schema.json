{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/home-lab/ai-generation.schema.json",
  "title": "home lab AI generation benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "timestamp",
    "host_class",
    "operating_environment",
    "runtime",
    "runtime_version",
    "model",
    "model_digest",
    "quantization",
    "context_tokens",
    "prompt_tokens",
    "output_tokens",
    "temperature",
    "repetitions",
    "metrics",
    "samples",
    "caveats"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "benchmark": {"const": "ai-generation"},
    "timestamp": {"type": "string", "format": "date-time"},
    "host_class": {"type": "string"},
    "operating_environment": {"type": "string"},
    "runtime": {"const": "ollama"},
    "runtime_version": {"type": "string"},
    "model": {"type": "string"},
    "model_digest": {"type": ["string", "null"]},
    "quantization": {"type": ["string", "null"]},
    "context_tokens": {"type": "integer", "minimum": 0},
    "prompt_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "temperature": {"type": "number"},
    "repetitions": {"type": "integer", "minimum": 1},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ttft_ms",
        "prompt_tokens_per_second",
        "generation_tokens_per_second",
        "wall_time_ms",
        "peak_memory_bytes"
      ],
      "properties": {
        "ttft_ms": {"type": ["number", "null"], "minimum": 0},
        "prompt_tokens_per_second": {"type": ["number", "null"], "minimum": 0},
        "generation_tokens_per_second": {"type": ["number", "null"], "minimum": 0},
        "wall_time_ms": {"type": ["number", "null"], "minimum": 0},
        "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "samples": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "caveats": {"type": "array", "items": {"type": "string"}}
  }
}
