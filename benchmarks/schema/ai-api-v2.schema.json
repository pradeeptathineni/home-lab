{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/home-lab/ai-api-v2.schema.json",
  "title": "home lab streaming AI API benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "timestamp", "host", "runtime", "model", "configuration", "samples", "aggregate", "memory", "power", "server_log", "caveats"],
  "properties": {
    "schema_version": {"const": "2"},
    "benchmark": {"const": "ai-api-generation"},
    "timestamp": {"type": "string", "format": "date-time"},
    "host": {"type": "object", "required": ["class", "os", "os_version", "architecture"]},
    "runtime": {"type": "object", "required": ["name", "version", "backend"]},
    "model": {"type": "object", "required": ["id", "family", "source", "revision", "digest", "quantization", "bytes"]},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threads", "context_tokens", "temperature", "warmups", "repetitions", "prompt"],
      "properties": {
        "threads": {"type": "integer", "minimum": 1},
        "context_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number"},
        "warmups": {"type": "integer", "minimum": 1},
        "repetitions": {"type": "integer", "minimum": 5},
        "prompt": {"type": "string"}
      }
    },
    "samples": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/sample"}},
    "aggregate": {
      "type": "object",
      "required": ["successes", "failures", "ttft_seconds", "wall_time_seconds", "generation_tokens_per_second"]
    },
    "memory": {
      "type": "object",
      "required": ["model_bytes", "process_rss_bytes_peak", "host_available_before_bytes", "host_available_after_bytes", "graphics_memory_bytes"]
    },
    "power": {"type": "object", "required": ["source", "battery_percent"]},
    "server_log": {"type": "string"},
    "caveats": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "warmup", "success", "ttft_seconds", "wall_time_seconds", "prompt_tokens", "output_tokens", "generation_tokens_per_second", "response", "exact_response", "error"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "warmup": {"type": "boolean"},
        "success": {"type": "boolean"},
        "ttft_seconds": {"type": ["number", "null"], "minimum": 0},
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "generation_tokens_per_second": {"type": ["number", "null"], "minimum": 0},
        "response": {"type": "string"},
        "exact_response": {"type": "boolean"},
        "error": {"type": ["string", "null"]}
      }
    }
  }
}
